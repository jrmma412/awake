#!/bin/zsh
# awake - keep your Mac awake with the screen on (like caffeinate, plus screen saver handling).
# Run `awake help` for usage.
zmodload zsh/datetime
VERSION=1.11.0
D=$HOME/.awake
PIDF=$D/pid; SAVED=$D/idleTime; UNTIL=$D/until
JPID=$D/jiggle.pid; JUNTIL=$D/jiggle.until; JMODE=$D/jiggle.mode
JIGGLE_EVERY=30   # seconds of no mouse/keyboard activity before a jiggle
SELF=${0:a}   # absolute path, symlinks NOT resolved (keeps working across Homebrew upgrades)
mkdir -p "$D" && chmod 700 "$D"

usage() {
  cat <<'EOT'
awake - keep your Mac awake with the screen on

  awake              turn on until you turn it off
  awake 2h           turn on for a while (30m, 2h, 1h30m, 90, 45s)
  awake off          turn off and restore your screen saver setting
  awake until 5pm    turn on until a clock time (5pm, 5:30pm, 17:30; tomorrow if already past).
                     Also works as: awake jiggle until 5pm / awake all until 5pm
  awake toggle       switch on/off
  awake status       show whether it is on, and time left
  awake menubar      (optional) menu bar icon, uses the SwiftBar app;  "awake menubar off" removes it,
                     "awake menubar quit" hides it until next login (both also in the icon's menu)
  awake jiggle       (optional) nudge the mouse 1 pixel when you've been idle, so apps (Teams, Slack,
                     remote desktops) don't mark you away. "awake jiggle 2h" for a while,
                     "awake jiggle off" stops it, "awake jiggle status" shows it
  awake jiggle random  (optional) like jiggle, but after a varied idle wait (20-75s) the pointer
                     glides along a curved path to a nearby random spot instead of a 1-pixel nudge.
                     "awake jiggle random 2h" / "awake jiggle random until 5pm" for a while
                     Running either one while jiggle is already on switches to that mode;
                     "awake jiggle simple" switches back to the default 1-pixel nudge.
  awake agent        (optional) always-on mode for servers/agents: system stays awake 24/7, also after
                     restarts, but the display sleeps and the screen locks normally.
                     "awake agent off" removes it, "awake agent status" shows it
  awake clamshell    will closing the lid sleep this Mac? Shows lid and sleep state, and prints the
                     command to keep it awake with the lid closed (and to undo it). Only reads; you
                     run the printed sudo command yourself
  awake all [time]   everything at once: keep awake + mouse jiggle + agent mode (agent mode has no timer;
                     it stays until "awake all off" or "awake agent off"). "awake all off" stops all three
  awake uninstall    remove awake  (--all also removes SwiftBar; -y skips the question)
  awake help         this help

Mix and match (each part is its own switch):
  awake all (or: all on)       keep awake + jiggle + agent mode, until you turn them off
  awake all random [time]      the same with random jiggle (also: all on random, all simple)
  awake all until 5pm          the same, keep-awake and jiggle stop at 5pm (agent mode has no timer)
  awake on jiggle 8h           keep awake + jiggle in one command, no agent (awake on jiggle until 5pm too)
  awake agent && awake jiggle  agent + jiggle (screen saver setting untouched)
  awake 2h && awake jiggle 2h  keep awake + jiggle for 2 hours, no agent
  awake jiggle 1h              jiggle only (apps see you active; nothing else changes)
  awake jiggle random 1h       the same with varied, curved pointer movement
  awake agent                  agent only (system stays awake, screen locks normally)
  awake status                 shows every part that is on
  awake off | awake jiggle off | awake agent off     turn one part off   (awake all off = all three)
EOT
}

# Current screen saver idle time in seconds, or "unset" if the key was never written
# (in which case macOS is using its built-in default).
cur() {
  local out rc i
  # Right after `killall cfprefsd` the preferences daemon is restarting and a read can briefly
  # report "does not exist" even though the value is set, so look again before calling it unset.
  for i in 1 2 3; do
    out=$(defaults -currentHost read com.apple.screensaver idleTime 2>&1); rc=$?
    if (( rc == 0 )) && [[ $out == <-> ]]; then echo "$out"; return; fi
    [[ $out == *"does not exist"* ]] || break
    sleep 0.4
  done
  if [[ $out == *"does not exist"* ]]; then echo unset
  else echo unknown   # defaults failed for some other reason: never guess
  fi
}
fmt() {
  case $1 in
    unset) echo "system default";;
    <->)   echo "${1}s";;
    *)     echo "unknown";;
  esac
}

# Turn a duration like 90, 45s, 30m, 2h, 1h30m into whole seconds. Fails on anything else.
parse_dur() {
  local rest=$1 total=0
  [[ -n $rest ]] || return 1
  if [[ $rest == <-> ]]; then (( ${#rest} <= 8 )) || return 1; total=$rest; rest=
  else
    while [[ -n $rest ]]; do
      [[ $rest =~ '^([0-9]+)([hms])(.*)$' ]] || return 1
      local n=$match[1] u=$match[2]; rest=$match[3]
      (( ${#n} <= 6 )) || return 1
      case $u in h) (( total += n*3600 ));; m) (( total += n*60 ));; s) (( total += n ));; esac
    done
  fi
  (( total > 0 && total <= 31536000 )) || return 1
  echo $(( total ))
}

# Turn a clock time (5pm, 5:30pm, 5:30 pm, 17:30, 17) into whole seconds from now, in REPLY.
# If that time has already passed today it means tomorrow (UNTIL_TOMORROW=1). Fails on anything else.
parse_until() {
  local t=${(L)${1// /}} h m ap tgt day
  [[ $t =~ '^([0-9]{1,2})(:([0-9]{2}))?(am|pm)?$' ]] || return 1
  h=$match[1]; m=${match[3]:-00}; ap=$match[4]
  [[ -n $ap || $t == *:* || ${#h} -ge 2 ]] || return 1   # a bare "5" is ambiguous: use 5pm or 17:00
  h=$(( 10#$h )); m=$(( 10#$m ))
  if [[ -n $ap ]]; then (( h >= 1 && h <= 12 )) || return 1; (( h %= 12 )); [[ $ap == pm ]] && (( h += 12 ))
  else (( h <= 23 )) || return 1; fi
  (( m <= 59 )) || return 1
  day=$(date +%Y-%m-%d)
  tgt=$(date -j -f "%Y-%m-%d %H:%M:%S" "$day $(printf %02d:%02d $h $m):00" +%s 2>/dev/null) || return 1
  UNTIL_TOMORROW=
  if (( tgt <= EPOCHSECONDS )); then
    tgt=$(date -j -v+1d -f "%Y-%m-%d %H:%M:%S" "$day $(printf %02d:%02d $h $m):00" +%s 2>/dev/null) || return 1
    UNTIL_TOMORROW=1
  fi
  REPLY=$(( tgt - EPOCHSECONDS ))
  (( REPLY > 0 )) || return 1
}

human() {
  local s=$1 h m
  h=$(( s/3600 )); m=$(( (s%3600)/60 ))
  if (( h > 0 )); then echo "${h}h ${m}m"
  elif (( m > 0 )); then echo "${m}m $(( s%60 ))s"
  else echo "${s}s"; fi
}

# True only if the pid file holds a number AND that pid is really a caffeinate process
# (guards against a stale or tampered pid file pointing at something else).
running() {
  [[ -f $PIDF ]] || return 1
  local p; p=$(<"$PIDF")
  [[ $p == <-> ]] || return 1
  [[ $(ps -p "$p" -o comm= 2>/dev/null) == *caffeinate ]]
}

# Put the saved screen saver setting back, then clear it. A saved number is written back;
# "unset" means there was no saved value, so the key is deleted to return to the system default.
# The saved value is only deleted once it has really been put back; if macOS refuses the write,
# it is kept so `awake off` can try again (your screen saver/lock is never silently lost).
restore() {
  rm -f "$UNTIL"
  [[ -f $SAVED ]] || return 0
  local v; v=$(cat "$SAVED" 2>/dev/null)
  [[ -n $v ]] || { rm -f "$SAVED"; return 0; }
  if [[ $v == <-> ]]; then
    defaults -currentHost write com.apple.screensaver idleTime -int "$v" || {
      echo "awake: could not restore your screen saver time (${v}s). It is still saved; run 'awake off' again." >&2; return 1; }
  elif [[ $v == unset ]]; then
    if ! defaults -currentHost delete com.apple.screensaver idleTime 2>/dev/null; then
      [[ $(cur) == unset ]] || {
        echo "awake: could not restore your screen saver to the system default. Run 'awake off' again." >&2; return 1; }
    fi
  fi
  rm -f "$SAVED"
  killall cfprefsd 2>/dev/null; sleep 0.5
}

# One awake command at a time changes settings (Terminal, menu bar and the timer can overlap).
# Waits up to ~6s; a lock left by a crashed command is taken over after a minute.
HAVE_LOCK=
# (A trap set inside a function would fire when the function returns, so it is set once here.)
trap '[[ -n $HAVE_LOCK ]] && rmdir "$D/lock" 2>/dev/null' EXIT
# Ctrl-C / kill: exit normally so the EXIT trap above still releases the lock.
trap 'exit 130' INT; trap 'exit 143' TERM HUP
lock() {
  local i
  for i in {1..60}; do
    if mkdir "$D/lock" 2>/dev/null; then HAVE_LOCK=1; return 0; fi
    [[ -n $(find "$D/lock" -maxdepth 0 -mmin +1 2>/dev/null) ]] && rmdir "$D/lock" 2>/dev/null
    sleep 0.1
  done
  echo "awake: busy (another awake command is running), try again"; return 1
}
unlock() { [[ -n $HAVE_LOCK ]] && rmdir "$D/lock" 2>/dev/null; HAVE_LOCK=; }

turn_on() {
  local secs=$1
  lock || return 1
  if running; then echo "awake: already on"; unlock; return 0; fi
  # Leftover state from a crash or reboot: restore the real original first, so we never
  # save our own "0" as the value to go back to.
  restore || { unlock; return 1; }
  rm -f "$PIDF"
  local orig; orig=$(cur)
  if [[ $orig == unknown ]]; then echo "awake: could not read the screen saver setting, not changing anything"; unlock; return 1; fi
  echo "$orig" > "$SAVED"
  if ! defaults -currentHost write com.apple.screensaver idleTime -int 0; then
    rm -f "$SAVED"; echo "awake: could not change the screen saver setting, not turning on"; unlock; return 1
  fi
  killall cfprefsd 2>/dev/null; sleep 0.3
  # A managed Mac (e.g. a work profile) can force the screen saver time; say so instead of pretending.
  [[ $(cur) == 0 ]] || echo "awake: note: this Mac seems to manage the screen saver setting, so the screen saver may still start"
  # d display, i idle, m disk, s system (AC). -u (declare user active) is only added with a
  # timer, because caffeinate gives -u its own short default timeout when no -t is set.
  local args=(-dims)
  if [[ -n $secs ]]; then args=(-dimsu -t "$secs"); echo $(( EPOCHSECONDS + secs )) > "$UNTIL"; fi
  # Values are passed as arguments, never spliced into the command string.
  # The background process restores the screen saver only if the pid file is still its own
  # (so `awake off` / a newer `awake` that already handled things is never undone).
  nohup zsh -c '
    pidf=$1; self=$2; shift 2
    caffeinate "$@" & p=$!
    echo $p > "$pidf"
    wait $p
    if [[ -f $pidf && $(<"$pidf") == $p ]]; then rm -f "$pidf"; "$self" _restore; fi
  ' _ "$PIDF" "$SELF" "${args[@]}" >/dev/null 2>&1 &
  # Wait (up to ~2s) for the background process to record its pid, so an immediate
  # `awake status` or `awake off` sees it.
  local i; for i in {1..20}; do [[ -s $PIDF ]] && break; sleep 0.1; done
  unlock
  if [[ -n $secs ]]; then echo "awake: ON for $(human $secs) (screen saver off, display/system kept awake)"
  else echo "awake: ON until you run 'awake off' (screen saver off, display/system kept awake)"; fi
}

turn_off() {
  lock || return 1
  if running; then
    local p; p=$(<"$PIDF")
    rm -f "$PIDF"          # remove first, so the background process knows we are handling the restore
    kill "$p" 2>/dev/null; sleep 0.3
  fi
  rm -f "$PIDF"
  if ! restore; then unlock; return 1; fi
  unlock
  echo "awake: OFF (settings restored, screen saver $(fmt "$(cur)"))"
}

show_status() {
  [[ -f $AGENT_PLIST ]] && agent_status
  if running; then
    local left=""
    if [[ -f $UNTIL ]]; then
      local u; u=$(<"$UNTIL")
      [[ $u == <-> ]] && (( u > EPOCHSECONDS )) && left=", $(human $(( u - EPOCHSECONDS ))) left (until $(date -r "$u" '+%-I:%M %p'))"
    fi
    echo "ON${left} (saved screen saver time: $(fmt "$(cat "$SAVED" 2>/dev/null)"))"
  elif [[ -f $SAVED ]]; then
    echo "OFF, but stale state found: run 'awake off' to restore screen saver to $(fmt "$(cat "$SAVED" 2>/dev/null)")"
  else
    echo "OFF (screen saver $(fmt "$(cur)"))"
  fi
  jiggle_running && jiggle_status   # last, so the menu's first-line read of the main status still works
  # Easy to forget once set, and it drains a battery with the lid closed: always mention it.
  [[ $(sleep_disabled) == yes ]] && echo "clamshell: system sleep is disabled (pmset disablesleep 1); see 'awake clamshell'"
  return 0
}

# ---- optional menu bar icon (SwiftBar plugin), installed with: awake menubar ----
menubar_plugin() {
  # Thin plugin: the menu itself is drawn by `awake _menu`, so upgrading awake updates the menu too.
  cat <<'PLUGIN'
#!/bin/zsh
# <swiftbar.hideAbout>true</swiftbar.hideAbout>
# <swiftbar.hideRunInTerminal>true</swiftbar.hideRunInTerminal>
# <swiftbar.hideLastUpdated>true</swiftbar.hideLastUpdated>
# <swiftbar.hideDisablePlugin>true</swiftbar.hideDisablePlugin>
# <swiftbar.hideSwiftBar>true</swiftbar.hideSwiftBar>
# Menu bar toggle for the awake command-line tool. Refreshes every 5 seconds.
exec "@AWAKE@" _menu
PLUGIN
}

# Menu contents for the SwiftBar plugin (internal: awake _menu).
menu() {
  local A st
  A=$(command -v awake) || A=$SELF; A=${A:a}
  st=$(show_status 2>&1 | grep -v '^agent mode' | head -1)
  if [[ $st == ON* ]]; then echo "☕"; else echo "💤"; fi
  echo "---"
  echo "$st"
  [[ -f $AGENT_PLIST ]] && echo "Agent mode: on (system stays awake, screen locks)"
  echo "---"
  if [[ $st == ON* ]]; then
    echo "Turn off | shell=$A param1=off terminal=false refresh=true"
  else
    [[ $st == *stale* ]] && echo "Restore screen saver setting | shell=$A param1=off terminal=false refresh=true"
    echo "Keep awake (until I turn it off) | shell=$A param1=on terminal=false refresh=true"
    echo "Keep awake for 30 minutes | shell=$A param1=on param2=30m terminal=false refresh=true"
    echo "Keep awake for 1 hour | shell=$A param1=on param2=1h terminal=false refresh=true"
    echo "Keep awake for 2 hours | shell=$A param1=on param2=2h terminal=false refresh=true"
  fi
  echo "---"
  echo "Hide icon until next login | shell=$A param1=menubar param2=quit terminal=false"
  echo "Remove menu bar icon | shell=$A param1=menubar param2=off terminal=false"
}

menubar() {
  local pd p bin setdir=0
  pd=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null) || pd=""
  pd=${pd/#\~/$HOME}
  # No plugin folder chosen yet: use ~/swiftbar-plugins and tell SwiftBar, so it doesn't ask.
  [[ -n $pd ]] || { pd=$HOME/swiftbar-plugins; setdir=1; }
  p=$pd/awake.5s.sh
  # Other SwiftBar plugins besides awake's? Then SwiftBar itself is left running.
  local others=0
  [[ -d $pd ]] && [[ -n $(find "$pd" -mindepth 1 -maxdepth 1 ! -name awake.5s.sh ! -name .DS_Store 2>/dev/null) ]] && others=1
  if [[ $1 == quit ]]; then
    # Hide for now: quit SwiftBar. It comes back at next login (or run 'awake menubar' to show it again).
    osascript -e 'quit app "SwiftBar"' 2>/dev/null
    echo "awake: menu bar icon hidden until next login (run 'awake menubar' to bring it back)"
    (( others )) && echo "awake: note: this also hid your other SwiftBar plugins"
    return 0
  fi
  if [[ $1 == off ]]; then
    if [[ -e $p ]]; then rm -f "$p" && echo "awake: menu bar icon removed"; else echo "awake: no menu bar icon to remove"; fi
    if (( ! others )) && pgrep -xq SwiftBar; then
      osascript -e 'quit app "SwiftBar"' 2>/dev/null
      echo "awake: quit SwiftBar (no other plugins). To stop it opening at login: brew uninstall --cask swiftbar"
    fi
    return 0
  fi
  [[ -z $1 || $1 == on ]] || { echo "usage: awake menubar [on|off|quit]"; return 1; }
  if [[ ! -d /Applications/SwiftBar.app && ! -d ~/Applications/SwiftBar.app ]]; then
    if command -v brew >/dev/null; then
      if [[ -z ${AWAKE_YES:-} ]]; then
        [[ -t 0 ]] || { echo "awake: SwiftBar needs installing; run 'awake menubar' in Terminal, or set AWAKE_YES=1"; return 1; }
        local ans; read -r "ans?awake: the menu bar icon needs SwiftBar (a free menu bar app). Install it with Homebrew now? (This also runs a normal Homebrew update.) [Y/n] "
        [[ -z $ans || $ans == [Yy]* ]] || { echo "awake: cancelled, nothing installed"; return 0; }
      fi
      echo "awake: installing SwiftBar (the menu bar host app) with Homebrew..."
      brew install --cask swiftbar || { echo "awake: SwiftBar install failed; get it from https://swiftbar.app and re-run 'awake menubar'"; return 1; }
    else
      echo "awake: SwiftBar is needed. Get it from https://swiftbar.app, then re-run 'awake menubar'"; return 1
    fi
  fi
  bin=$(command -v awake) || bin=$SELF
  bin=${bin:a}
  [[ $bin =~ '^[A-Za-z0-9_./-]+$' ]] || { echo "awake: install path has unusual characters ($bin); not installing the menu bar icon"; return 1; }
  mkdir -p "$pd"
  menubar_plugin | sed "s|@AWAKE@|$bin|g" > "$p" && chmod +x "$p"
  if (( setdir )); then
    defaults write com.ameba.SwiftBar PluginDirectory "$pd"
    # A running SwiftBar only reads the folder at launch, so restart it.
    pgrep -xq SwiftBar && { osascript -e 'quit app "SwiftBar"' 2>/dev/null; sleep 1; }
  fi
  open -a SwiftBar 2>/dev/null
  echo "awake: menu bar icon installed ($p)"
}

# ---- optional mouse jiggle, started with: awake jiggle [time] ----
# Keeping the Mac awake does not stop chat apps and remote-desktop tools from marking you "away":
# they watch for real keyboard/mouse activity. This nudges the pointer 1 pixel out and back whenever
# there has been no input for JIGGLE_EVERY seconds (so it never fights you while you are using the Mac).
# Needs the Accessibility permission (macOS only lets trusted apps send input events).
jiggle_script() {
  cat <<'JS'
function run(argv) {
  ObjC.import('CoreGraphics'); ObjC.import('Foundation'); ObjC.import('ApplicationServices');
  if (argv[0] === 'check') return $.AXIsProcessTrusted() ? 'ok' : 'noaccess';
  var every = parseInt(argv[0]), end = parseFloat(argv[1]);   // end = epoch seconds, 0 = no end
  if (argv[2] === 'random') return randomJiggle(end);
  while (end === 0 || Date.now() / 1000 < end) {
    var idle = $.CGEventSourceSecondsSinceLastEventType(1, 0xFFFFFFFF);   // HID state, any input event
    if (idle >= every) {
      var p = $.CGEventGetLocation($.CGEventCreate(null));
      $.CGEventPost(0, $.CGEventCreateMouseEvent(null, 5, $.CGPointMake(p.x + 1, p.y), 0));
      $.NSThread.sleepForTimeInterval(0.05);
      $.CGEventPost(0, $.CGEventCreateMouseEvent(null, 5, p, 0));
    }
    $.NSThread.sleepForTimeInterval(5);
  }
}
// "awake jiggle random": after a varied idle wait, glide the pointer along a curved, eased path
// to a nearby random spot (kept on the screen it is on). Moves only, never clicks.
function rnd(a, b) { return a + Math.random() * (b - a); }
function randomJiggle(end) {
  var wait = rnd(20, 75);
  while (end === 0 || Date.now() / 1000 < end) {
    var idle = $.CGEventSourceSecondsSinceLastEventType(1, 0xFFFFFFFF);
    if (idle >= wait) { glide(); wait = rnd(20, 75); }
    $.NSThread.sleepForTimeInterval(rnd(2, 6));
  }
}
function glide() {
  var p = $.CGEventGetLocation($.CGEventCreate(null));
  var b = screenOf(p);
  var dist = rnd(40, 250), ang = rnd(0, 2 * Math.PI);
  var tx = clamp(p.x + dist * Math.cos(ang), b.x0 + 5, b.x1 - 5);
  var ty = clamp(p.y + dist * Math.sin(ang), b.y0 + 5, b.y1 - 5);
  // control point off to one side of the straight line, for a curve
  var bend = rnd(-0.5, 0.5) * dist;
  var cx = (p.x + tx) / 2 - Math.sin(ang) * bend, cy = (p.y + ty) / 2 + Math.cos(ang) * bend;
  var steps = Math.round(rnd(18, 45));
  for (var i = 1; i <= steps; i++) {
    var t = i / steps, e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;   // ease in-out
    var x = (1 - e) * (1 - e) * p.x + 2 * (1 - e) * e * cx + e * e * tx + rnd(-0.6, 0.6);
    var y = (1 - e) * (1 - e) * p.y + 2 * (1 - e) * e * cy + e * e * ty + rnd(-0.6, 0.6);
    $.CGEventPost(0, $.CGEventCreateMouseEvent(null, 5, $.CGPointMake(x, y), 0));
    $.NSThread.sleepForTimeInterval(rnd(0.008, 0.028));
  }
}
function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
function screenOf(p) {
  var ids = Ref(), n = Ref();
  $.CGGetDisplaysWithPoint(p, 1, ids, n);
  var id = n[0] > 0 ? ids[0] : $.CGMainDisplayID();
  var r = $.CGDisplayBounds(id);
  return {x0: r.origin.x, y0: r.origin.y, x1: r.origin.x + r.size.width, y1: r.origin.y + r.size.height};
}
JS
}
# True only if the pid file holds a number AND that pid is really an osascript process.
jiggle_running() {
  [[ -f $JPID ]] || return 1
  local p; p=$(<"$JPID")
  [[ $p == <-> ]] || return 1
  [[ $(ps -p "$p" -o comm= 2>/dev/null) == *osascript ]]
}
jiggle_status() {
  if jiggle_running; then
    local left=""
    if [[ -f $JUNTIL ]]; then
      local u; u=$(<"$JUNTIL")
      [[ $u == <-> ]] && (( u > EPOCHSECONDS )) && left=", $(human $(( u - EPOCHSECONDS ))) left (until $(date -r "$u" '+%-I:%M %p'))"
    fi
    if [[ $(cat "$JMODE" 2>/dev/null) == random ]]; then
      echo "jiggle: ON, random${left} (glides the mouse to a nearby spot after 20-75s of no input)"
    else
      echo "jiggle: ON${left} (nudges the mouse after ${JIGGLE_EVERY}s of no input)"
    fi
  else
    echo "jiggle: OFF"
  fi
}
jiggle_off() {
  lock || return 1
  if jiggle_running; then
    local p; p=$(<"$JPID")
    rm -f "$JPID"          # remove first, so the background process knows we are handling it
    kill "$p" 2>/dev/null
  fi
  rm -f "$JPID" "$JUNTIL" "$JMODE"
  unlock
  [[ -n $1 ]] || echo "awake: jiggle OFF"
}
jiggle() {
  local mode=normal explicit=""
  case ${1:-} in
    random) mode=random; explicit=1; shift;;
    simple|normal) explicit=1; shift;;   # simple is the default mode, named so you can switch back to it
  esac
  local arg=${1:-on} secs=""
  case $arg in
    status) jiggle_status; return 0;;
    off|stop) jiggle_off; return 0;;
    toggle) if jiggle_running; then jiggle_off; return 0; fi;;
    on) [[ -z $2 ]] || secs=$(parse_dur "$2") || { echo "awake: bad time '$2' (try 30m, 2h, 1h30m)"; return 1; };;
    *) secs=$(parse_dur "$arg") || { echo "usage: awake jiggle [simple|random] [time|on|off|toggle|status]"; return 1; };;
  esac
  if jiggle_running; then
    if [[ -n $explicit ]]; then jiggle_off quiet   # "jiggle random" / "jiggle simple" while on: switch mode
    else echo "awake: jiggle is already on (use 'awake jiggle simple' or 'awake jiggle random' to switch mode, or 'awake jiggle off' to stop)"; return 0; fi
  fi
  if [[ $(osascript -l JavaScript -e "$(jiggle_script)" check 2>/dev/null) != ok ]]; then
    echo "awake: jiggle needs the Accessibility permission for this app (Terminal, iTerm, ...)."
    echo "  System Settings > Privacy & Security > Accessibility: turn it on for your terminal app,"
    echo "  then run 'awake jiggle' again. (Opening that page now.)"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility" 2>/dev/null
    return 1
  fi
  lock || return 1
  local end=0
  if [[ -n $secs ]]; then end=$(( EPOCHSECONDS + secs )); echo "$end" > "$JUNTIL"; else rm -f "$JUNTIL"; fi
  echo "$mode" > "$JMODE"
  # Values are passed as arguments, never spliced into a command string.
  # The pid file is only trusted while it is still this process's own (see turn_on).
  nohup zsh -c '
    pidf=$1; untilf=$2; src=$3; shift 3
    osascript -l JavaScript -e "$src" "$@" & p=$!
    echo $p > "$pidf"
    wait $p
    if [[ -f $pidf && $(<"$pidf") == $p ]]; then rm -f "$pidf" "$untilf" "${pidf%.pid}.mode"; fi
  ' _ "$JPID" "$JUNTIL" "$(jiggle_script)" "$JIGGLE_EVERY" "$end" "$mode" >/dev/null 2>&1 &
  local i; for i in {1..20}; do [[ -s $JPID ]] && break; sleep 0.1; done
  unlock
  local how="mouse nudged after ${JIGGLE_EVERY}s idle"
  [[ $mode == random ]] && how="random: mouse glides to a nearby spot after 20-75s idle"
  if [[ -n $secs ]]; then echo "awake: jiggle ON for $(human $secs) ($how)"
  else echo "awake: jiggle ON until you run 'awake jiggle off' ($how)"; fi
  echo "  note: this also keeps the screen saver / auto-lock from starting while it runs"
}

# ---- optional always-on "agent mode" (LaunchAgent), installed with: awake agent ----
# Keeps the SYSTEM awake (idle, disk, system-on-AC assertions) so background services, bots and
# AI agents keep running, and starts again automatically at login. Unlike `awake on`, it does NOT
# keep the display on and does NOT touch the screen saver, so the screen still turns off and locks.
# ---- keep the menu bar icon up: if the icon is installed but SwiftBar is not running, open it ----
# Runs on every user command (not on menubar/uninstall/internal ones), so "Hide icon until next login"
# lasts until the next time you use awake or log in. Silent and never fails the command.
ensure_menubar() {
  local pd
  pd=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null) || return 0
  pd=${pd/#\~/$HOME}
  [[ -e $pd/awake.5s.sh ]] || return 0
  pgrep -xq SwiftBar || open -ga SwiftBar >/dev/null 2>&1
  return 0
}

AGENT_LABEL=com.jrmma412.awake.agent
AGENT_PLIST=$HOME/Library/LaunchAgents/$AGENT_LABEL.plist
agent_loaded() { launchctl print "gui/$UID/$AGENT_LABEL" >/dev/null 2>&1; }
agent_status() {
  if [[ ! -f $AGENT_PLIST ]]; then echo "agent mode: not installed (add it with 'awake agent')"; return 0; fi
  if agent_loaded && pgrep -qf "caffeinate -ims"; then
    echo "agent mode: ON (system kept awake 24/7 and after restarts; display sleeps and the screen locks normally)"
  else
    echo "agent mode: installed but not running; run 'awake agent' again to restart it"
  fi
}
agent() {
  case ${1:-on} in
    status) agent_status; return 0;;
    off)
      if [[ -f $AGENT_PLIST ]]; then
        launchctl bootout "gui/$UID/$AGENT_LABEL" 2>/dev/null
        rm -f "$AGENT_PLIST" && echo "awake: agent mode removed (normal sleep settings apply again)"
      else
        echo "awake: agent mode is not installed"
      fi
      return 0;;
    on) ;;
    *) echo "usage: awake agent [on|off|status]"; return 1;;
  esac
  mkdir -p "${AGENT_PLIST:h}"
  # Fixed contents; no user input is written into the plist.
  cat > "$AGENT_PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string><string>-c</string>
    <string>pd=\$(defaults read com.ameba.SwiftBar PluginDirectory 2&gt;/dev/null); if [ -e "\$pd/awake.5s.sh" ]; then /usr/bin/open -ga SwiftBar; fi; exec /usr/bin/caffeinate -ims</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PL
  chmod 644 "$AGENT_PLIST"
  launchctl bootout "gui/$UID/$AGENT_LABEL" 2>/dev/null
  if launchctl bootstrap "gui/$UID" "$AGENT_PLIST" 2>/dev/null || agent_loaded; then
    sleep 0.5; agent_status
    echo "  (on a MacBook, 'system awake' applies while plugged in; the screen still locks per your settings)"
  else
    echo "awake: could not start agent mode (launchctl refused). The file is at $AGENT_PLIST"; return 1
  fi
}

# ---- awake clamshell: lid-closed sleep state, and the command to change it ----
# Read-only. Closing a MacBook's lid uses a different sleep path that caffeinate (awake on / agent)
# cannot block. Only macOS's own clamshell mode (on power with an external display it counts) or
# `pmset disablesleep 1` keeps it awake. awake never runs sudo: it prints the command for you to run.

# A flag from the kernel power manager (IOPMrootDomain): yes / no / n/a.
pm_flag() {
  local v
  v=$(ioreg -r -c IOPMrootDomain -d 1 2>/dev/null | grep -m1 "\"$1\" = " | sed 's/.* = //')
  case $v in Yes) echo yes;; No) echo no;; *) echo n/a;; esac
}
# Whether `pmset disablesleep 1` is in effect: yes / no / n/a. Only ever reads (pmset -g).
sleep_disabled() {
  local v; v=$(pm_flag SleepDisabled)
  if [[ $v == n/a ]]; then
    case $(pmset -g 2>/dev/null | awk '$1 == "SleepDisabled" {print $2; exit}') in 1) v=yes;; 0) v=no;; esac
  fi
  echo $v
}
clamshell() {
  case ${1:-status} in status) ;; *) echo "usage: awake clamshell [status]"; return 1;; esac
  local lid causes dis src
  lid=$(pm_flag AppleClamshellState)
  causes=$(pm_flag AppleClamshellCausesSleep)
  dis=$(sleep_disabled)
  src=$(pmset -g batt 2>/dev/null | sed -n "s/.*drawing from '\(.*\)'.*/\1/p" | head -1)
  echo "clamshell (lid closed) status:"
  printf "  %-32s %s\n" "power:" "${src:-unknown}" "lid closed:" "$lid" \
    "closing the lid sleeps the Mac:" "$causes" "sleep disabled (pmset):" "$dis"
  echo
  if [[ $dis == yes ]]; then
    echo "Sleep is disabled: the Mac stays awake with the lid closed, and never sleeps on its own."
    [[ -z $src || $src == "AC Power" ]] || echo "It's on battery right now, so it will run until the battery is empty. Plug it in."
    echo "To undo (asks for your password):"
    echo "  sudo pmset -a disablesleep 0"
  elif [[ $causes == n/a && $lid == n/a ]]; then
    echo "macOS doesn't report a lid here (desktop Mac or virtual machine), so there's nothing to change."
  elif [[ $causes == no ]]; then
    echo "Closing the lid won't sleep this Mac right now: macOS counts an attached display for clamshell mode."
    echo "If you unplug that display, check again. To stay awake with the lid closed regardless (asks for your password):"
    echo "  sudo pmset -a disablesleep 1      (undo: sudo pmset -a disablesleep 0)"
  else
    echo "Closing the lid will put this Mac to sleep. 'awake' and 'awake agent' can't stop that."
    echo "To keep it awake with the lid closed (asks for your password; stops ALL system sleep until undone):"
    echo "  sudo pmset -a disablesleep 1"
    echo "To undo:"
    echo "  sudo pmset -a disablesleep 0"
  fi
}

# ---- awake all [time|off]: awake on + jiggle + agent mode in one go ----
# Each part is still its own command (awake on / awake jiggle / awake agent), so any one can be
# switched off alone. A part that cannot start (e.g. no Accessibility permission for jiggle) is
# reported and the others still run.
all() {
  [[ ${1:-} == on ]] && shift   # "awake all on [time]" is the same as "awake all [time]"
  local jmode=""                # "awake all random [time]" / "all simple": pick the jiggle mode in one go
  case ${1:-} in random|simple|normal) jmode=$1; shift;; esac
  local arg=${1:-} secs=""
  if [[ $arg == off || $arg == stop ]]; then
    turn_off; jiggle_off
    if [[ -f $AGENT_PLIST ]]; then agent off; else echo "awake: agent mode: nothing to stop (it was never installed; add it with 'awake agent')"; fi
    echo "awake all: everything is off"
    return 0
  fi
  if [[ -n $arg ]]; then secs=$(parse_dur "$arg") || { echo "usage: awake all [simple|random] [time|off]"; return 1; }; fi
  local rc=0 jg=" + jiggle"
  turn_on "$secs" || rc=1
  jiggle ${jmode:+"$jmode"} ${arg:+"$arg"} || { rc=1; jg=" (jiggle did not start)"; }
  agent on || rc=1
  echo
  echo "awake all: on${jg}${jmode:+ ($jmode)}${secs:+, timer $(human $secs)}; agent mode stays on until 'awake all off' or 'awake agent off'"
  return $rc
}

# ---- uninstall: awake uninstall [--all] [-y] ----
uninstall() {
  local all=0 yes=0 a
  for a in "$@"; do
    case $a in --all) all=1;; -y|--yes) yes=1;; *) echo "usage: awake uninstall [--all] [-y]"; return 1;; esac
  done
  local MARK="# added by awake" self=$SELF brewed=0
  [[ ${self:A} == */Cellar/awake/* ]] && brewed=1
  local sbdir; sbdir=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null) || sbdir=$HOME/swiftbar-plugins
  sbdir=${sbdir/#\~/$HOME}
  # Other SwiftBar plugins (besides awake's)? Then --all leaves SwiftBar alone.
  local others=0
  [[ -d $sbdir ]] && [[ -n $(find "$sbdir" -mindepth 1 -maxdepth 1 ! -name awake.5s.sh ! -name .DS_Store 2>/dev/null) ]] && others=1

  echo "This will:"
  echo "  - turn awake off and restore your screen saver setting"
  echo "  - remove the awake menu bar icon (if added)"
  jiggle_running && echo "  - stop the mouse jiggle"
  [[ -f $AGENT_PLIST ]] && echo "  - remove agent mode (the always-on login item)"
  if (( brewed )); then echo "  - run: brew uninstall awake"; else echo "  - delete $self"; fi
  echo "  - remove any PATH line awake added to ~/.zshrc / ~/.zprofile"
  echo "  - delete ~/.awake (awake's state folder)"
  if (( all && others )); then
    echo "  - keep SwiftBar: you have other plugins in $sbdir"
  elif (( all )); then
    echo "  - quit and uninstall SwiftBar and its settings"
    echo "  - delete $sbdir"
  fi
  if (( ! yes )); then
    local ans
    if [[ -t 0 ]]; then read -r "ans?Continue? [y/N] "
    elif { : </dev/tty; } 2>/dev/null; then read -r "ans?Continue? [y/N] " </dev/tty
    else echo "Not running in a terminal: re-run with -y to confirm."; return 1; fi
    [[ $ans == [Yy]* ]] || { echo "Cancelled. Nothing was changed."; return 0; }
  fi

  # Restore the screen saver first; if that fails, stop and keep everything needed to retry.
  turn_off >/dev/null || { echo "Stopped: awake is busy or could not restore your screen saver setting. Nothing was removed; try again."; return 1; }
  jiggle_off quiet
  rm -f "$sbdir/awake.5s.sh"
  [[ -f $AGENT_PLIST ]] && agent off
  local f t
  for f in ~/.zshrc ~/.zprofile; do
    if [[ -f $f ]] && grep -q "$MARK" "$f"; then
      t=$(mktemp) || { echo "could not edit $f; remove the line ending in '$MARK' yourself"; continue; }
      grep -v "$MARK" "$f" > "$t"
      if (( $? <= 1 )); then cat "$t" > "$f" && echo "removed PATH line from $f"   # in place: keeps symlinks
      else echo "could not edit $f; remove the line ending in '$MARK' yourself"; fi
      rm -f "$t"
    fi
  done
  rm -rf "$D"

  if (( all && others )); then
    echo "kept SwiftBar (you have other plugins in $sbdir)"
  elif (( all )); then
    osascript -e 'quit app "SwiftBar"' 2>/dev/null; sleep 1
    if command -v brew >/dev/null && brew list --cask swiftbar >/dev/null 2>&1; then
      brew uninstall --cask --zap swiftbar >/dev/null 2>&1 && echo "uninstalled SwiftBar"
    fi
    local app
    for app in /Applications/SwiftBar.app ~/Applications/SwiftBar.app; do
      [[ -d $app ]] && rm -rf "$app" && echo "removed $app"
    done
    defaults delete com.ameba.SwiftBar 2>/dev/null
    rm -f "$sbdir/.DS_Store"
    [[ -d $sbdir ]] && rmdir "$sbdir" 2>/dev/null && echo "removed $sbdir"
  fi

  if (( brewed )); then
    if brew uninstall awake >/dev/null 2>&1; then echo "uninstalled awake (Homebrew)"
    else echo "brew uninstall awake failed; run it yourself to finish"; fi
    brew untap jrmma412/awake >/dev/null 2>&1
  else
    rm -f "$self" && echo "removed $self"
    [[ ${self:h} == $HOME/bin ]] && rmdir "$HOME/bin" 2>/dev/null   # only if now empty
  fi
  echo "awake is uninstalled. Open a new Terminal tab to finish."
}

# "until 5pm" anywhere in the arguments becomes a duration in seconds, so every command below just works.
if (( ${argv[(I)until]} )); then
  _i=${argv[(I)until]}
  _t=${(j::)argv[$((_i+1)),-1]}
  [[ -n $_t ]] && parse_until "$_t" || { echo "awake: bad time '$_t' after 'until' (try 5pm, 5:30pm, 17:30)"; exit 1; }
  set -- "${(@)argv[1,$((_i-1))]}" "$REPLY"
  echo "awake: until $(date -r $(( EPOCHSECONDS + REPLY )) '+%-I:%M %p')${UNTIL_TOMORROW:+ tomorrow}"
fi

case $1 in menubar|uninstall|_restore|_menu|help|-h|--help|-v|--version|version) ;; *) ensure_menubar;; esac

case $1 in
  on)
    if [[ $2 == jiggle ]]; then   # awake on jiggle [time]: keep awake + jiggle, no agent mode
      if [[ -n $3 ]]; then s=$(parse_dur "$3") || { echo "awake: bad time '$3' (try 30m, 2h, 1h30m)"; exit 1; }; fi
      rc=0; turn_on "$s" || rc=1
      jiggle ${3:+"$3"} || rc=1
      exit $rc
    fi
    if [[ -n $2 ]]; then
      s=$(parse_dur "$2") || { echo "awake: bad time '$2' (try 30m, 2h, 1h30m)"; exit 1; }
    fi
    turn_on "$s";;
  off|stop)   turn_off;;
  toggle)     if running; then turn_off; else turn_on; fi;;
  status|st)  show_status;;
  menubar)    menubar "${2:-}";;
  agent)      agent "${2:-on}";;
  jiggle)     shift; jiggle "$@";;
  clamshell)  clamshell "${2:-}";;
  all)        shift; all "$@";;
  uninstall)  shift; uninstall "$@";;
  _restore)   lock && { restore; unlock; };;
  _menu)      menu;;   # internal: called by the background process when caffeinate exits
  help|-h|--help) usage;;
  -v|--version|version) echo "awake $VERSION";;
  "")         turn_on;;
  *)
    if s=$(parse_dur "$1"); then turn_on "$s"
    else echo "awake: unknown command or time '$1'"; echo; usage; exit 1; fi;;
esac
