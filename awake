#!/bin/zsh
# awake - keep your Mac awake with the screen on (like caffeinate, plus screen saver handling).
# Run `awake help` for usage.
zmodload zsh/datetime
VERSION=1.2.3
D=$HOME/.awake
PIDF=$D/pid; SAVED=$D/idleTime; UNTIL=$D/until
SELF=${0:a}   # absolute path, symlinks NOT resolved (keeps working across Homebrew upgrades)
mkdir -p "$D" && chmod 700 "$D"

usage() {
  cat <<'EOT'
awake - keep your Mac awake with the screen on

  awake              turn on until you turn it off
  awake 2h           turn on for a while (30m, 2h, 1h30m, 90, 45s)
  awake off          turn off and restore your screen saver setting
  awake toggle       switch on/off
  awake status       show whether it is on, and time left
  awake menubar      (optional) menu bar icon, uses the SwiftBar app;  "awake menubar off" removes it
  awake uninstall    remove awake  (--all also removes SwiftBar; -y skips the question)
  awake help         this help
EOT
}

# Current screen saver idle time in seconds, or "unset" if the key was never written
# (in which case macOS is using its built-in default).
cur() {
  local out rc i
  # Right after `killall cfprefsd` the preferences daemon is restarting and a read can briefly
  # report "does not exist" even though the value is set, so look again before calling it unset.
  for i in 1 2 3; do
    out=$(defaults -currentHost read com.apple.screensaver idleTime 2>&1); rc=$?
    if (( rc == 0 )) && [[ $out == <-> ]]; then echo "$out"; return; fi
    [[ $out == *"does not exist"* ]] || break
    sleep 0.4
  done
  if [[ $out == *"does not exist"* ]]; then echo unset
  else echo unknown   # defaults failed for some other reason: never guess
  fi
}
fmt() {
  case $1 in
    unset) echo "system default";;
    <->)   echo "${1}s";;
    *)     echo "unknown";;
  esac
}

# Turn a duration like 90, 45s, 30m, 2h, 1h30m into whole seconds. Fails on anything else.
parse_dur() {
  local rest=$1 total=0
  [[ -n $rest ]] || return 1
  if [[ $rest == <-> ]]; then total=$rest; rest=
  else
    while [[ -n $rest ]]; do
      [[ $rest =~ '^([0-9]+)([hms])(.*)$' ]] || return 1
      local n=$match[1] u=$match[2]; rest=$match[3]
      (( ${#n} <= 6 )) || return 1
      case $u in h) (( total += n*3600 ));; m) (( total += n*60 ));; s) (( total += n ));; esac
    done
  fi
  (( total > 0 && total <= 31536000 )) || return 1
  echo $(( total ))
}

human() {
  local s=$1 h m
  h=$(( s/3600 )); m=$(( (s%3600)/60 ))
  if (( h > 0 )); then echo "${h}h ${m}m"
  elif (( m > 0 )); then echo "${m}m $(( s%60 ))s"
  else echo "${s}s"; fi
}

# True only if the pid file holds a number AND that pid is really a caffeinate process
# (guards against a stale or tampered pid file pointing at something else).
running() {
  [[ -f $PIDF ]] || return 1
  local p; p=$(<"$PIDF")
  [[ $p == <-> ]] || return 1
  [[ $(ps -p "$p" -o comm= 2>/dev/null) == *caffeinate ]]
}

# Put the saved screen saver setting back, then clear it. A saved number is written back;
# "unset" means there was no saved value, so the key is deleted to return to the system default.
restore() {
  rm -f "$UNTIL"
  [[ -f $SAVED ]] || return 0
  local v; v=$(cat "$SAVED" 2>/dev/null)
  [[ -n $v ]] || return 0
  if [[ $v == <-> ]]; then
    defaults -currentHost write com.apple.screensaver idleTime -int "$v"
  elif [[ $v == unset ]]; then
    defaults -currentHost delete com.apple.screensaver idleTime 2>/dev/null
  fi
  rm -f "$SAVED"
  killall cfprefsd 2>/dev/null; sleep 0.5
}

turn_on() {
  local secs=$1
  if running; then echo "awake: already on"; return 0; fi
  # Simple lock so two starts at once (e.g. menu bar click + Terminal) can't both run.
  if ! mkdir "$D/lock" 2>/dev/null; then
    if [[ -n $(find "$D/lock" -maxdepth 0 -mmin +1 2>/dev/null) ]]; then rmdir "$D/lock" 2>/dev/null; mkdir "$D/lock" 2>/dev/null || return 1
    else echo "awake: another start is in progress, try again"; return 1; fi
  fi
  trap 'rmdir "$D/lock" 2>/dev/null' EXIT
  # Leftover state from a crash or reboot: restore the real original first, so we never
  # save our own "0" as the value to go back to.
  restore
  rm -f "$PIDF"
  local orig; orig=$(cur)
  if [[ $orig == unknown ]]; then echo "awake: could not read the screen saver setting, not changing anything"; return 1; fi
  echo "$orig" > "$SAVED"
  defaults -currentHost write com.apple.screensaver idleTime -int 0
  killall cfprefsd 2>/dev/null; sleep 0.3
  # d display, i idle, m disk, s system (AC). -u (declare user active) is only added with a
  # timer, because caffeinate gives -u its own short default timeout when no -t is set.
  local args=(-dims)
  if [[ -n $secs ]]; then args=(-dimsu -t "$secs"); echo $(( EPOCHSECONDS + secs )) > "$UNTIL"; fi
  # Values are passed as arguments, never spliced into the command string.
  # The background process restores the screen saver only if the pid file is still its own
  # (so `awake off` / a newer `awake` that already handled things is never undone).
  nohup zsh -c '
    pidf=$1; self=$2; shift 2
    caffeinate "$@" & p=$!
    echo $p > "$pidf"
    wait $p
    if [[ -f $pidf && $(<"$pidf") == $p ]]; then rm -f "$pidf"; "$self" _restore; fi
  ' _ "$PIDF" "$SELF" "${args[@]}" >/dev/null 2>&1 &
  # Wait (up to ~2s) for the background process to record its pid, so an immediate
  # `awake status` or `awake off` sees it.
  local i; for i in {1..20}; do [[ -s $PIDF ]] && break; sleep 0.1; done
  if [[ -n $secs ]]; then echo "awake: ON for $(human $secs) (screen saver off, display/system kept awake)"
  else echo "awake: ON until you run 'awake off' (screen saver off, display/system kept awake)"; fi
}

turn_off() {
  if running; then
    local p; p=$(<"$PIDF")
    rm -f "$PIDF"          # remove first, so the background process knows we are handling the restore
    kill "$p" 2>/dev/null; sleep 0.3
  fi
  restore
  rm -f "$PIDF"
  echo "awake: OFF (settings restored, screen saver $(fmt "$(cur)"))"
}

show_status() {
  if running; then
    local left=""
    if [[ -f $UNTIL ]]; then
      local u; u=$(<"$UNTIL")
      [[ $u == <-> ]] && (( u > EPOCHSECONDS )) && left=", $(human $(( u - EPOCHSECONDS ))) left"
    fi
    echo "ON${left} (saved screen saver time: $(fmt "$(cat "$SAVED" 2>/dev/null)"))"
  elif [[ -f $SAVED ]]; then
    echo "OFF, but stale state found: run 'awake off' to restore screen saver to $(fmt "$(cat "$SAVED" 2>/dev/null)")"
  else
    echo "OFF (screen saver $(fmt "$(cur)"))"
  fi
}

# ---- optional menu bar icon (SwiftBar plugin), installed with: awake menubar ----
menubar_plugin() {
  cat <<'PLUGIN'
#!/bin/zsh
# <swiftbar.hideAbout>true</swiftbar.hideAbout>
# <swiftbar.hideRunInTerminal>true</swiftbar.hideRunInTerminal>
# <swiftbar.hideLastUpdated>true</swiftbar.hideLastUpdated>
# <swiftbar.hideDisablePlugin>true</swiftbar.hideDisablePlugin>
# <swiftbar.hideSwiftBar>true</swiftbar.hideSwiftBar>
# Menu bar toggle for the awake command-line tool. Refreshes every 5 seconds.
A="@AWAKE@"
st=$("$A" status 2>&1)
if [[ $st == ON* ]]; then echo "☕"; else echo "💤"; fi
echo "---"
echo "$st"
echo "---"
if [[ $st == ON* ]]; then
  echo "Turn off | shell=$A param1=off terminal=false refresh=true"
else
  [[ $st == *stale* ]] && echo "Restore screen saver setting | shell=$A param1=off terminal=false refresh=true"
  echo "Keep awake (until I turn it off) | shell=$A param1=on terminal=false refresh=true"
  echo "Keep awake for 30 minutes | shell=$A param1=on param2=30m terminal=false refresh=true"
  echo "Keep awake for 1 hour | shell=$A param1=on param2=1h terminal=false refresh=true"
  echo "Keep awake for 2 hours | shell=$A param1=on param2=2h terminal=false refresh=true"
fi
PLUGIN
}

menubar() {
  local pd p bin setdir=0
  pd=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null) || pd=""
  pd=${pd/#\~/$HOME}
  # No plugin folder chosen yet: use ~/swiftbar-plugins and tell SwiftBar, so it doesn't ask.
  [[ -n $pd ]] || { pd=$HOME/swiftbar-plugins; setdir=1; }
  p=$pd/awake.5s.sh
  if [[ $1 == off ]]; then rm -f "$p" && echo "awake: menu bar icon removed"; return 0; fi
  if [[ ! -d /Applications/SwiftBar.app && ! -d ~/Applications/SwiftBar.app ]]; then
    if command -v brew >/dev/null; then
      if [[ -t 0 && -z ${AWAKE_YES:-} ]]; then
        local ans; read -r "ans?awake: the menu bar icon needs SwiftBar (a free menu bar app). Install it with Homebrew now? (This also runs a normal Homebrew update.) [Y/n] "
        [[ -z $ans || $ans == [Yy]* ]] || { echo "awake: cancelled, nothing installed"; return 0; }
      fi
      echo "awake: installing SwiftBar (the menu bar host app) with Homebrew..."
      brew install --cask swiftbar || { echo "awake: SwiftBar install failed; get it from https://swiftbar.app and re-run 'awake menubar'"; return 1; }
    else
      echo "awake: SwiftBar is needed. Get it from https://swiftbar.app, then re-run 'awake menubar'"; return 1
    fi
  fi
  bin=$(command -v awake) || bin=$SELF
  [[ $bin =~ '^[A-Za-z0-9_./-]+$' ]] || { echo "awake: install path has unusual characters ($bin); not installing the menu bar icon"; return 1; }
  mkdir -p "$pd"
  menubar_plugin | sed "s|@AWAKE@|$bin|g" > "$p" && chmod +x "$p"
  if (( setdir )); then
    defaults write com.ameba.SwiftBar PluginDirectory "$pd"
    # A running SwiftBar only reads the folder at launch, so restart it.
    pgrep -xq SwiftBar && { osascript -e 'quit app "SwiftBar"' 2>/dev/null; sleep 1; }
  fi
  open -a SwiftBar 2>/dev/null
  echo "awake: menu bar icon installed ($p)"
}

# ---- uninstall: awake uninstall [--all] [-y] ----
uninstall() {
  local all=0 yes=0 a
  for a in "$@"; do
    case $a in --all) all=1;; -y|--yes) yes=1;; *) echo "usage: awake uninstall [--all] [-y]"; return 1;; esac
  done
  local MARK="# added by awake" self=$SELF brewed=0
  [[ $self == */Cellar/awake/* || -L $self ]] && brewed=1
  local sbdir; sbdir=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null) || sbdir=$HOME/swiftbar-plugins
  sbdir=${sbdir/#\~/$HOME}

  echo "This will:"
  echo "  - turn awake off and restore your screen saver setting"
  echo "  - remove the awake menu bar icon (if added)"
  if (( brewed )); then echo "  - run: brew uninstall awake"; else echo "  - delete $self"; fi
  echo "  - remove any PATH line awake added to ~/.zshrc / ~/.zprofile"
  echo "  - delete ~/.awake (awake's state folder)"
  if (( all )); then
    echo "  - quit and uninstall SwiftBar and its settings"
    echo "  - delete $sbdir if nothing else is left in it"
  fi
  if (( ! yes )); then
    [[ -t 0 ]] || { echo "Not running in a terminal: re-run with -y to confirm."; return 1; }
    local ans; read -r "ans?Continue? [y/N] "
    [[ $ans == [Yy]* ]] || { echo "Cancelled. Nothing was changed."; return 0; }
  fi

  turn_off >/dev/null
  rm -f "$sbdir/awake.5s.sh"
  local f t
  for f in ~/.zshrc ~/.zprofile; do
    if [[ -f $f ]] && grep -q "$MARK" "$f"; then
      t=$(mktemp) && grep -v "$MARK" "$f" > "$t"; cat "$t" > "$f"; rm -f "$t"   # in place: keeps symlinks
      echo "removed PATH line from $f"
    fi
  done
  rm -rf "$D"

  if (( all )); then
    osascript -e 'quit app "SwiftBar"' 2>/dev/null; sleep 1
    if command -v brew >/dev/null && brew list --cask swiftbar >/dev/null 2>&1; then
      brew uninstall --cask --zap swiftbar >/dev/null 2>&1 && echo "uninstalled SwiftBar"
    elif [[ -d /Applications/SwiftBar.app ]]; then
      rm -rf /Applications/SwiftBar.app && echo "removed /Applications/SwiftBar.app"
    fi
    defaults delete com.ameba.SwiftBar 2>/dev/null
    rmdir "$sbdir" 2>/dev/null && echo "removed $sbdir"
    [[ -d $sbdir ]] && echo "kept $sbdir (it has other plugins in it)"
  fi

  if (( brewed )); then
    brew uninstall awake >/dev/null 2>&1 && echo "uninstalled awake (Homebrew)"
    brew untap jrmma412/awake >/dev/null 2>&1
  else
    rm -f "$self" && echo "removed $self"
    [[ ${self:h} == $HOME/bin ]] && rmdir "$HOME/bin" 2>/dev/null   # only if now empty
  fi
  echo "awake is uninstalled. Open a new Terminal tab to finish."
}

case $1 in
  on)
    if [[ -n $2 ]]; then
      s=$(parse_dur "$2") || { echo "awake: bad time '$2' (try 30m, 2h, 1h30m)"; exit 1; }
    fi
    turn_on "$s";;
  off|stop)   turn_off;;
  toggle)     if running; then turn_off; else turn_on; fi;;
  status|st)  show_status;;
  menubar)    menubar "${2:-}";;
  uninstall)  shift; uninstall "$@";;
  _restore)   restore;;   # internal: called by the background process when caffeinate exits
  help|-h|--help) usage;;
  -v|--version|version) echo "awake $VERSION";;
  "")         turn_on;;
  *)
    if s=$(parse_dur "$1"); then turn_on "$s"
    else echo "awake: unknown command or time '$1'"; echo; usage; exit 1; fi;;
esac
